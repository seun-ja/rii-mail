{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiiMail",
  "version": "0.1.0",
  "identifier": "com.seunaminu.riimail",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RiiMail",
        "url": "login.html",
        "width": 600,
        "height": 640,
        "minWidth": 600,
        "minHeight": 640,
        "maxWidth": 600,
        "maxHeight": 640,
        "resizable": false,
        "maximizable": false,
        "decorations": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../packaging/macos-arm64/build/local-model/": "local-model/",
      "../llm/local_inference.py": "llm/local_inference.py"
    }
  }
}
