{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiiMail",
  "version": "0.1.0",
  "identifier": "com.seunaminu.riimail",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RiiMail",
        "url": "splash.html",
        "width": 280,
        "height": 280,
        "minWidth": 280,
        "minHeight": 280,
        "maxWidth": 280,
        "maxHeight": 280,
        "center": true,
        "focus": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../llm/local_inference.py": "llm/local_inference.py"
    }
  }
}
