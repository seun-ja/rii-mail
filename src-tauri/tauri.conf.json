{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiiMail",
  "version": "0.1.0",
  "identifier": "com.seunaminu.riimail",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RiiMail",
        "url": "login.html",
        "width": 500,
        "height": 700,
        "resizable": false,
        "decorations": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
