{
  "name": "riimail-frontend-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./packaging/macos/dev.sh",
    "dev:macos-arm64": "./packaging/macos-arm64/dev.sh",
    "dev:macos-intel": "./packaging/macos-intel/dev.sh",
    "build:macos-arm64": "./packaging/macos-arm64/build-dmg.sh",
    "build:macos-intel": "./packaging/macos-intel/build-dmg.sh",
    "test": "node --test src/**/*.test.js",
    "test:frontend": "node --test src/**/*.test.js",
    "test:backend": "./packaging/macos/run-rust-tests.sh backend",
    "test:backend:macos-arm64": "PYO3_CONFIG_FILE=\"$(pwd)/packaging/macos-arm64/build/pyo3-config.txt\" PYO3_ENVIRONMENT_SIGNATURE=riimail-python-3.12.15-macos-arm64-tests DYLD_LIBRARY_PATH=\"$(pwd)/packaging/macos-arm64/build\" cargo test --manifest-path src-tauri/Cargo.toml",
    "test:backend:macos-intel": "PYO3_CONFIG_FILE=\"$(pwd)/packaging/macos-intel/build/pyo3-config.txt\" PYO3_ENVIRONMENT_SIGNATURE=riimail-python-3.12.15-macos-x86_64-tests DYLD_LIBRARY_PATH=\"$(pwd)/packaging/macos-intel/build\" cargo test --manifest-path src-tauri/Cargo.toml",
    "test:llm": "./packaging/macos/run-rust-tests.sh llm",
    "test:llm:macos-arm64": "PYO3_CONFIG_FILE=\"$(pwd)/packaging/macos-arm64/build/pyo3-config.txt\" PYO3_ENVIRONMENT_SIGNATURE=riimail-python-3.12.15-macos-arm64-tests DYLD_LIBRARY_PATH=\"$(pwd)/packaging/macos-arm64/build\" cargo test --manifest-path src-tauri/Cargo.toml --package llm --lib",
    "test:llm:macos-intel": "PYO3_CONFIG_FILE=\"$(pwd)/packaging/macos-intel/build/pyo3-config.txt\" PYO3_ENVIRONMENT_SIGNATURE=riimail-python-3.12.15-macos-x86_64-tests DYLD_LIBRARY_PATH=\"$(pwd)/packaging/macos-intel/build\" cargo test --manifest-path src-tauri/Cargo.toml --package llm --lib",
    "test:python": "python3 -m unittest discover -s llm/tests -p 'test_*.py'",
    "test:all": "npm run test:frontend && npm run test:backend && npm run test:llm && npm run test:python"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-notification": "~2.4.0"
  }
}
